# Erforderlich: Dieses Beispiel durch die IP oder den DNS-Namen deiner IOmeter-Bridge ersetzen.
IOMETER_HOST=iometer.local

# Die folgenden Werte müssen normalerweise nicht geändert werden.
IOMETER_SCHEME=http
IOMETER_PORT=80
IOMETER_TIMEOUT_SECONDS=3

# Auf dem Docker-Host veröffentlichte Web-Ports.
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# Vor einer Freigabe außerhalb des vertrauenswürdigen LANs ändern.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Prometheus speichert die Historie in einem benannten Docker-Volume.
# Einheiten: y, w, d, h, m, s oder ms. 1y entspricht exakt 365d.
# Für praktisch unbegrenzte Aufbewahrung kann z. B. 100y verwendet werden.
# Nicht auf 0 setzen: Das deaktiviert die Aufbewahrungsgrenze nicht.
PROMETHEUS_RETENTION=90d
